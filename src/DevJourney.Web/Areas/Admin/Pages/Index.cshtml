@page
@model DevJourney.Web.Pages.Index

@{
    ViewData["Title"] = "Dashboard";
}

<!-- PAGE CONTENT — replace with the real page content -->
<main class="admin-content">
    <div class="admin-page-intro">
        <p>
            This is a sample page to demonstrate the admin panel layout (sidebar, header, and footer).
        </p>
        <p>
            To add a real page, copy this file as a starting point and replace the
            <code>admin-content</code>
            section with your content — full details in the
            <a href="">developer guide</a>
            .
        </p>
    </div>

    <div class="card-custom admin-sample-card">
        <h2>
            Sample content card
        </h2>
        <p>
            This card uses the same shared
            <code>card-custom</code>
            class as the profile card and sidebar widgets on the other pages — anything
            you built for the public site works here too, with no extra changes.
        </p>
    </div>
</main>
