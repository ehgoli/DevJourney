@{
    bool isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<!DOCTYPE html>
<html html lang="@CultureInfo.CurrentUICulture.Name"
      dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta name="description" content="Content management panel for Ehsan Goli's personal site.">

    <title>
        @ViewData["Title"] | Ehsan Goli
    </title>


    <partial name="_Stylesheets"/>

    <!-- Admin layout: sidebar, header, footer -->
    <link href="/assets/css/admin-layout.css" rel="stylesheet">

    @await RenderSectionAsync("_Stylesheets", required: false)
</head>
<body class="admin-body">

<div class="admin-shell" id="adminShell">

    <!-- ================= DESKTOP SIDEBAR ================= -->
    <aside class="admin-sidebar d-none d-lg-flex">
        <div class="admin-sidebar-header">
            <a class="admin-sidebar-brand" href="/">
                        <span class="admin-sidebar-brand-mark">
                            EG
                        </span>
                <span class="admin-sidebar-brand-text">
                            <span class="admin-sidebar-brand-title">
                                Admin Panel
                            </span>
                            <span class="admin-sidebar-brand-subtitle">
                                Ehsan Goli
                            </span>
                        </span>
            </a>
            <button aria-expanded="true" aria-label="Collapse/expand sidebar" class="admin-sidebar-collapse-btn"
                    id="adminSidebarCollapseBtn" type="button">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <nav aria-label="Admin navigation" class="admin-nav">
            <a aria-current="page" class="admin-nav-link is-active" href="/Admin" title="Dashboard">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>
            <a class="admin-nav-link" href="#" title="Projects">
                <i class="bi bi-kanban"></i>
                <span>Projects</span>
            </a>
            <a class="admin-nav-link" href="#" title="Articles">
                <i class="bi bi-journal-text"></i>
                <span>Articles</span>
            </a>
            <a class="admin-nav-link" href="#" title="Courses">
                <i class="bi bi-mortarboard"></i>
                <span>Courses</span>
            </a>
            <a class="admin-nav-link" href="#" title="Certificates">
                <i class="bi bi-award"></i>
                <span>Certificates</span>
            </a>
            <a class="admin-nav-link" href="#" title="Messages">
                <i class="bi bi-envelope"></i>
                <span>Messages</span>
            </a>
            <a class="admin-nav-link" href="#" title="Settings">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            <a class="admin-sidebar-back" href="/" title="Back to site">
                <i class="bi bi-house-door"></i>
                <span>Back to site</span>
            </a>
        </div>
    </aside>

    <!-- ================= MOBILE OFFCANVAS SIDEBAR ================= -->
    <div aria-labelledby="adminOffcanvasLabel" class="offcanvas offcanvas-@(isRtl?"start":"end") site-offcanvas admin-offcanvas"
         id="adminOffcanvas" tabindex="-1">
        <div class="offcanvas-header">
            <a class="admin-sidebar-brand" href="/">
                        <span class="admin-sidebar-brand-mark">
                            EG
                        </span>
                <span class="admin-sidebar-brand-text">
                            <span class="admin-sidebar-brand-title" id="adminOffcanvasLabel">
                                Admin Panel
                            </span>
                            <span class="admin-sidebar-brand-subtitle">
                                Ehsan Goli
                            </span>
                        </span>
            </a>
            <button aria-label="Close menu" class="btn-close" data-bs-dismiss="offcanvas" type="button"></button>
        </div>
        <div class="offcanvas-body">
            <nav aria-label="Admin navigation (mobile)" class="admin-nav">
                <a aria-current="page" class="admin-nav-link is-active" href="/Admin">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-kanban"></i>
                    <span>Projects</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-journal-text"></i>
                    <span>Articles</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-mortarboard"></i>
                    <span>Courses</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-award"></i>
                    <span>Certificates</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-envelope"></i>
                    <span>Messages</span>
                </a>
                <a class="admin-nav-link" href="#">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </nav>
            <div class="admin-sidebar-footer">
                <a class="admin-sidebar-back" href="/">
                    <i class="bi bi-house-door"></i>
                    <span>Back to site</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ================= MAIN COLUMN ================= -->
    <div class="admin-main">

        <!-- HEADER -->
        <header class="admin-header">
            <button aria-controls="adminOffcanvas" aria-label="Open menu" class="admin-header-menu-btn"
                    data-bs-target="#adminOffcanvas" data-bs-toggle="offcanvas" type="button">
                <i class="bi bi-list"></i>
            </button>

            <div class="admin-header-titles">
                <div class="admin-header-eyebrow">
                    Admin Panel
                </div>
                <h1 class="admin-header-title">
                    Dashboard
                </h1>
            </div>

            <div class="admin-header-actions">
                <button aria-label="Toggle dark/light mode" aria-pressed="false" class="admin-header-theme-btn"
                        id="themeToggleBtn" title="Toggle dark/light mode" type="button">
                    <i class="bi bi-moon-stars theme-toggle-icon-dark"></i>
                    <i class="bi bi-sun theme-toggle-icon-light"></i>
                </button>

                <div class="dropdown">
                    <button aria-expanded="false" class="admin-user" data-bs-toggle="dropdown" type="button">
                        <img alt="Ehsan Goli" class="admin-user-avatar" src="/assets/images/avatar.jpg">
                        <span class="admin-user-name">
                                    Ehsan Goli
                                </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end admin-user-menu">
                        <div class="admin-user-menu-header">
                            <img alt="Ehsan Goli" class="admin-user-menu-avatar" src="/assets/images/avatar.jpg">
                            <div class="admin-user-menu-identity">
                                        <span class="admin-user-menu-name">
                                            Ehsan Goli
                                        </span>
                                <span class="admin-user-menu-email">
                                            demo@example.com
                                        </span>
                            </div>
                        </div>
                        <div class="admin-user-menu-group">
                            <a class="admin-user-menu-item" href="/">
                                <i class="bi bi-house"></i>
                                View homepage
                            </a>
                            <a class="admin-user-menu-item" href="#">
                                <i class="bi bi-person"></i>
                                My profile
                            </a>
                            <a class="admin-user-menu-item" href="#">
                                <i class="bi bi-gear"></i>
                                Site settings
                            </a>
                            <a class="admin-user-menu-item" href="">
                                <i class="bi bi-question-circle"></i>
                                Developer guide
                            </a>
                        </div>
                        <div class="admin-user-menu-divider"></div>
                        <div class="admin-user-menu-group">
                            <a class="admin-user-menu-item admin-user-menu-item--danger" href="#">
                                <i class="bi bi-box-arrow-right"></i>
                                Log out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT — replace with the real page content -->
        @RenderBody()

        <!-- FOOTER -->
        <footer class="admin-footer">
            <a href="">
                Documentation
            </a>
            <div class="admin-footer-credit">
                <strong>Admin Panel</strong>
                — © 2026 Ehsan Goli
            </div>
        </footer>

    </div>

</div>


<partial name="_Scripts"/>

<!-- Scripts -->
<script src="/assets/js/admin-sidebar.js"></script>
</body>
</html>
