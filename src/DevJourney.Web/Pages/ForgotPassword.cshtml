@page "/Forgot-Password"
@model DevJourney.Web.Pages.ForgotPasswordModel

@{
    Layout = "Shared/_AuthLayout";
    ViewData["Title"] = Localizer["ForgotPasswordPageTitle"];
}

@section Scripts {
    <script src="/assets/js/auth-forgot-password.js"></script>
}

<main class="auth-page">
    <div aria-hidden="true" id="particles-bg"></div>

    <div class="auth-card card-custom">

        <!-- Brand -->
        <div class="auth-brand">
            <a class="site-logo" asp-page="./Index">
                <span class="site-logo-mark">
                    EG
                </span>
                <span class="site-logo-text">
                    احسان گلی
                </span>
            </a>
        </div>

        <!-- Step indicator -->
        @if (Model.ForgotPassword.CurrentStep < 4)
        {
            <div class="auth-steps" id="authSteps">
                <span class="auth-step @(Model.ForgotPassword.CurrentStep >= 1 ? "is-active" : "")"></span>
                <span class="auth-step @(Model.ForgotPassword.CurrentStep >= 2 ? "is-active" : "")"></span>
                <span class="auth-step @(Model.ForgotPassword.CurrentStep >= 3 ? "is-active" : "")"></span>
            </div>
        }

        <!--
            ==================================================
            STEP 1 — Phone number
            ==================================================
        -->
        <div class="auth-step-panel @(Model.ForgotPassword.CurrentStep == 1 ? "" : "d-none")"
             data-step="1">

            <div class="auth-heading">
                <h1 class="auth-title">
                    @Localizer["ForgotPassword"]
                </h1>

                <p class="auth-subtitle">
                    @Localizer["EnterPhoneForVerification"]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ForgotPassword.ErrorMessage))
            {
                <div class="auth-alert" role="alert">
                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        @Model.ForgotPassword.ErrorMessage
                    </span>
                </div>
            }

            <form method="post"
                  asp-page-handler="RequestCode"
                  class="auth-form"
                  id="forgotStep1Form">

                <div class="mb-3">
                    <label class="contact-label" asp-for="ForgotPassword.PhoneNumber">
                        @Localizer["PhoneNumber"]
                    </label>

                    <input asp-for="ForgotPassword.PhoneNumber"
                           autocomplete="tel"
                           class="form-control contact-input"
                           dir="ltr"
                           id="forgotPhone"
                           inputmode="tel"
                           placeholder="09123456789"
                           type="tel" />

                    <span asp-validation-for="ForgotPassword.PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <button class="contact-submit" type="submit">
                    <span>
                        @Localizer["SendVerificationCode"]
                    </span>

                    <i class="bi bi-send"></i>
                </button>
            </form>
        </div>

        <!--
            ==================================================
            STEP 2 — Verification code
            ==================================================
        -->
        <div class="auth-step-panel @(Model.ForgotPassword.CurrentStep == 2 ? "" : "d-none")"
             data-step="2">

            <div class="auth-heading">
                <h1 class="auth-title">
                    @Localizer["EnterVerificationCode"]
                </h1>

                <p class="auth-subtitle">
                    @Localizer["VerificationCodeSentTo", Model.ForgotPassword.PhoneNumber]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ForgotPassword.ErrorMessage))
            {
                <div class="auth-alert" role="alert">
                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        @Model.ForgotPassword.ErrorMessage
                    </span>
                </div>
            }

            <form method="post"
                  asp-page-handler="VerifyCode"
                  class="auth-form"
                  id="forgotStep2Form">

                <input asp-for="ForgotPassword.PhoneNumber"
                       type="hidden" />

                <div class="mb-3">
                    <label class="contact-label" asp-for="ForgotPassword.Code">
                        @Localizer["VerificationCode"]
                    </label>

                    <input asp-for="ForgotPassword.Code"
                           autocomplete="one-time-code"
                           class="form-control contact-input auth-otp-input"
                           dir="ltr"
                           id="forgotOtp"
                           inputmode="numeric"
                           maxlength="5"
                           placeholder="12345"
                           type="text" />

                    <span asp-validation-for="ForgotPassword.Code"
                          class="text-danger">
                    </span>
                </div>

                <p class="auth-resend">
                    @Localizer["DidNotReceiveCode"]

                    <button class="auth-link auth-link-btn"
                            id="resendCodeBtn"
                            type="submit"
                            formaction="?handler=ResendCode">
                        @Localizer["ResendCode"]

                        <span id="resendTimer"></span>
                    </button>
                </p>

                <button class="contact-submit" type="submit">
                    <span>
                        @Localizer["VerifyCode"]
                    </span>

                    <i class="bi bi-check2"></i>
                </button>
            </form>

            <form method="post"
                  asp-page-handler="RequestCode"
                  class="d-inline">

                <input asp-for="ForgotPassword.PhoneNumber"
                       type="hidden" />

                <button class="auth-back-link"
                        id="backToPhoneBtn"
                        type="submit">
                    <i class="bi bi-arrow-right"></i>
                    @Localizer["BackAndEditPhone"]
                </button>
            </form>
        </div>

        <!--
            ==================================================
            STEP 3 — New password
            ==================================================
        -->
        <div class="auth-step-panel @(Model.ForgotPassword.CurrentStep == 3 ? "" : "d-none")"
             data-step="3">

            <div class="auth-heading">
                <h1 class="auth-title">
                    @Localizer["SetNewPassword"]
                </h1>

                <p class="auth-subtitle">
                    @Localizer["EnterNewPassword"]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ForgotPassword.ErrorMessage))
            {
                <div class="auth-alert" role="alert">
                    <i class="bi bi-exclamation-triangle"></i>

                    <span>
                        @Model.ForgotPassword.ErrorMessage
                    </span>
                </div>
            }

            <form method="post"
                  asp-page-handler="ConfirmReset"
                  class="auth-form"
                  id="forgotStep3Form">

                <input asp-for="ForgotPassword.ResetToken"
                       type="hidden" />

                <div class="mb-3">
                    <label class="contact-label"
                           asp-for="ForgotPassword.NewPassword">
                        @Localizer["NewPassword"]
                    </label>

                    <div class="auth-password-field">
                        <input asp-for="ForgotPassword.NewPassword"
                               autocomplete="new-password"
                               class="form-control contact-input"
                               id="forgotNewPassword"
                               placeholder="@Localizer["NewPassword"]"
                               type="password" />

                        <button aria-label="@Localizer["ShowPassword"]"
                                aria-pressed="false"
                                class="auth-password-toggle"
                                data-hide-label="@Localizer["HidePassword"]"
                                data-show-label="@Localizer["ShowPassword"]"
                                data-target="forgotNewPassword"
                                type="button">

                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ForgotPassword.NewPassword"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="contact-label"
                           asp-for="ForgotPassword.ConfirmPassword">
                        @Localizer["ConfirmNewPassword"]
                    </label>

                    <div class="auth-password-field">
                        <input asp-for="ForgotPassword.ConfirmPassword"
                               autocomplete="new-password"
                               class="form-control contact-input"
                               id="forgotConfirmPassword"
                               placeholder="@Localizer["ConfirmNewPassword"]"
                               type="password" />

                        <button aria-label="@Localizer["ShowPassword"]"
                                aria-pressed="false"
                                class="auth-password-toggle"
                                data-hide-label="@Localizer["HidePassword"]"
                                data-show-label="@Localizer["ShowPassword"]"
                                data-target="forgotConfirmPassword"
                                type="button">

                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ForgotPassword.ConfirmPassword"
                          class="text-danger">
                    </span>
                </div>

                <button class="contact-submit" type="submit">
                    <span>
                        @Localizer["SaveNewPassword"]
                    </span>

                    <i class="bi bi-shield-check"></i>
                </button>
            </form>
        </div>

        <!--
            ==================================================
            DONE
            ==================================================
        -->
        <div class="auth-step-panel @(Model.ForgotPassword.CurrentStep == 4 ? "" : "d-none")"
             data-step="done">

            <div class="auth-heading">
                <i class="bi bi-patch-check-fill auth-success-icon"></i>

                <h1 class="auth-title">
                    @Localizer["PasswordChangedSuccessfully"]
                </h1>

                <p class="auth-subtitle">
                    @Localizer["LoginWithNewPassword"]
                </p>
            </div>

            <a class="contact-submit"
               asp-page="./Login">

                <span>
                    @Localizer["SignIn"]
                </span>

                <i class="bi bi-box-arrow-in-right"></i>
            </a>
        </div>

        @if (Model.ForgotPassword.CurrentStep < 4)
        {
            <div class="auth-switch">
                @Localizer["RememberedPassword"]

                <a class="auth-link"
                   asp-page="./Login">
                    @Localizer["SignIn"]
                </a>
            </div>
        }

    </div>
</main>