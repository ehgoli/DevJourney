@page
@model DevJourney.Web.Pages.LoginModel

@{
    Layout = "Shared/_AuthLayout";

    ViewData["Title"] = Localizer["LoginPageTitle"];
}


<main class="auth-page">
    <div aria-hidden="true" id="particles-bg"></div>

    <div class="auth-card card-custom">

        <!-- Brand — also doubles as the way back to the site -->
        <div class="auth-brand">
            <a class="site-logo" href="/">
                <span class="site-logo-mark"> EG </span>
                <span class="site-logo-text"> احسان گلی </span>
            </a>
        </div>

        <div class="auth-heading">
            <h1 class="auth-title">
                @Localizer["LoginTitle"]
            </h1>
            <p class="auth-subtitle">
                @Localizer["LoginSubtitle"]
            </p>
        </div>

        <!--
        Server-side message placeholder — hidden by default.
        Remove d-none once the backend can render a real
        error here (e.g. invalid credentials).
        -->
        @if (!string.IsNullOrEmpty(Model.LoginInputs.ErrorMessage))
        {
            <div class="auth-alert" id="loginAlert" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <span>
                    @Model.LoginInputs.ErrorMessage
                </span>
            </div>

        }
        <form asp-page="/Login" class="auth-form" id="loginForm" method="post">

            <!-- Phone — kept LTR like any digit string (see .github-stars in components.css for the same convention) -->
            <div class="mb-3">
                <label class="contact-label" asp-for="LoginInputs.Phone">
                    @Localizer["PhoneNumber"]
                </label>
                <input autocomplete="tel" class="form-control contact-input" dir="ltr" inputmode="tel"
                       asp-for="LoginInputs.Phone" placeholder="09123456789" required="" type="tel">
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="contact-label" asp-for="LoginInputs.Password">
                    @Localizer["Password"]
                </label>
                <div class="auth-password-field">
                    <input autocomplete="current-password" class="form-control contact-input"
                           asp-for="LoginInputs.Password" placeholder="@(Localizer["Password"])" required="">
                    <button aria-label="@(Localizer["ShowPassword"])" aria-pressed="false" class="auth-password-toggle"
                            data-hide-label="@(Localizer["HidePassword"])" data-show-label="@(Localizer["ShowPassword"])"
                            data-target="LoginInputs_HidePassword" type="button">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Remember me + Forgot password -->
            <div class="auth-form-row">
                <div class="auth-check">
                    <input class="form-check-input" asp-for="LoginInputs.RememberMe" type="checkbox">
                    <label asp-for="LoginInputs.RememberMe">
                        @Localizer["RememberMe"]
                    </label>
                </div>
                <a class="auth-link" href="">
                    @Localizer["ForgotPassword"]
                </a>
            </div>

            <!-- Submit -->
            <button class="contact-submit" type="submit">
                <span> @Localizer["Login"] </span>
                <i class="bi bi-box-arrow-in-right"></i>
            </button>
        </form>

        <div class="auth-switch">
            @Localizer["NoAccount"]
            <a class="auth-link" href="">
                @Localizer["RegisterPrompt"]
            </a>
        </div>

    </div>
</main>