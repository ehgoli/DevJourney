<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta name="description" content="Write this page's description here.">

    <title>
        @ViewData["Title"] | Ehsan Goli
    </title>

    <!-- Set theme (light/dark) early, right before the first stylesheet -->
    <script src="assets/js/theme-init.js"></script>

    <!-- Bootstrap — standard build -->
    <link href="assets/vendor/bootstrap/css/bootstrap.css" rel="stylesheet">

    <!-- Bootstrap icons -->
    <link href="assets/vendor/bootstrap/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Styles CSS -->
    <!-- Layout: variables, base reset, container, shared header & footer -->
    <link href="assets/css/layout.css" rel="stylesheet">

    <!-- Components: reusable cards & elements (article/project/course/GitHub card, sidebar widget, breadcrumb, form fields) -->
    <link href="assets/css/components.css" rel="stylesheet">

    <!-- Import Fonts: switches automatically based on <html lang> -->
    <link href="assets/fonts/style.css" rel="stylesheet">

    @await RenderSectionAsync("_Stylesheets",required: false)

    <!-- Dark Mode: color variable overrides for dark theme (data-bs-theme="dark") — must always be the last CSS file loaded -->
    <link href="assets/css/dark-mode.css" rel="stylesheet">
</head>
<body>
    
    <button aria-label="Toggle dark/light mode" aria-pressed="false" class="theme-toggle-btn" id="themeToggleBtn" title="Toggle dark/light mode" type="button">
        <i class="bi bi-moon-stars theme-toggle-icon-dark"></i>
        <i class="bi bi-sun theme-toggle-icon-light"></i>
    </button>


    <partial name="_Header" />

    <main>
        <section class="my-new-page-section">
            <div class="container">
                @RenderBody()
            </div>
        </section>
    </main>

    <partial name="_Footer" />

    <!-- Scripts -->
    <script src="assets/vendor/bootstrap/js/bootstrap.bundle.js"></script>
    <script src="assets/js/theme-toggle.js"></script>
</body>
</html>
