{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "Caching": {
    "DefaultExpiration": "00:30:00"
  },

  "Storage": {
    "RootPath": "wwwroot/uploads"
  },

  "ClamAV": {
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 30
  },

  "ImageProcessing": {
    "WebPQuality": 82,
    "MaxWidth": 4000,
    "MaxHeight": 4000,
    "MaxFrames": 1,
    "MaxPixelMemoryBytes": 268435456
  },
  
  "Identity": {
    "PasswordReset": {
      "MaxVerificationAttempts": 5,
      "VerificationCodeLifetime": "00:05:00",
      "ResendCooldown": "00:01:00",
      "LockDuration": "06:00:00",
      "ResetTokenLifetime": "00:05:00"
    }
  },
  
  "AllowedHosts": "*"
}
